# No Supabase URL, API key, or Railway service is required by the active Cloudflare deployment.
# Set these values as Cloudflare Worker secrets before first production deployment.
SYNAX_PERSON_1_PASSWORD=use-a-unique-password-at-least-12-characters
SYNAX_PERSON_2_PASSWORD=use-a-different-unique-password-at-least-12-characters
SYNAX_ADMIN_PASSWORD=use-a-third-unique-password-at-least-12-characters
SYNAX_MEDIA_SIGNING_SECRET=generate-a-random-secret-of-at-least-32-characters

# Optional: Cloudflare Calls TURN credentials for improved cross-network WebRTC.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
